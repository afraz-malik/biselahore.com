# --- CMS (/cms) -------------------------------------------------------
# These are secrets — set them in a gitignored .env.local (dev) or
# .env.production.local (server), never in the tracked .env file.

# Optional override for the SQLite file. Defaults:
#   NODE_ENV=production → data/cms.sqlite   (tracked in git)
#   otherwise            → data/cms.dev.sqlite (gitignored)
# CMS_DB_PATH=./data/cms.dev.sqlite

# Random string (32+ chars) used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
CMS_SESSION_SECRET=

# Admin login password hash. Generate with:
#   npm run cms:hash-password -- "your-password"
CMS_ADMIN_PASSWORD_HASH=

# --- Seed script only (Node, never read by the browser) ----------------
# Base URL that relative media/download paths are resolved against once,
# at seed time. Every href/image path in the CMS is stored as a full
# absolute URL after seeding — this only matters when re-seeding.
# Defaults to https://data.biselahore.com/dt if unset.
# MEDIA_BASE_URL=https://data.biselahore.com/dt
